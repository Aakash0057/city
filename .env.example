# Backend Configuration
DATABASE_URL=sqlite:///./citycare.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/citycare

SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
RESET_TOKEN_EXPIRE_MINUTES=15
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Frontend Configuration (.env.local)
# VITE_API_URL=/api  (proxied to http://localhost:8000 in dev)
